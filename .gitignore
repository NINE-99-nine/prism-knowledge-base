# ============================================================
#  Prism · 棱镜 — git 忽略规则
#
#  原则：代码进版本控制，运行时状态不进。
#  data/ 里全是本机相关的索引（文件路径、向量、备份），
#  换台机器就无意义，所以整体忽略。
# ============================================================

# ---- 运行时数据：数据库 / 备份 / 本地设置 ----
/data/*
!/data/.gitkeep

# ---- Python 独立环境（约 67 MB，可用 安装.bat 重建）----
/.venv/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
*~
*.bak
*.bak_*
